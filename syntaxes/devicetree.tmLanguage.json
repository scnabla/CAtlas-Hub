{
  "name": "DeviceTree",
  "scopeName": "source.dts.catlas",
  "patterns": [
    { "include": "#common" },
    {
      "match": "([a-zA-Z0-9,._+?#-]+)(@)([a-zA-Z0-9,._+-]+)",
      "captures": {
        "1": { "name": "entity.name.type.node.dts" },
        "2": { "name": "punctuation.separator.address.dts" },
        "3": { "name": "constant.numeric.address.dts" }
      }
    },
    { "match": "(?:[a-zA-Z0-9,._+?#-]+|/)(?=\\s*\\{)", "name": "entity.name.type.node.dts" },
    { "match": "[a-zA-Z0-9,._+?#-]+", "name": "variable.other.property.dts" },
    {
      "begin": "=",
      "beginCaptures": { "0": { "name": "keyword.operator.assignment.dts" } },
      "end": ";",
      "endCaptures": { "0": { "name": "punctuation.terminator.dts" } },
      "patterns": [
        { "include": "#common" },
        {
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            { "include": "#common" },
            { "match": "[[:xdigit:]]{2}", "name": "constant.numeric.byte.dts" }
          ]
        },
        { "match": "\\b(?:0[xX][[:xdigit:]]+|[0-9]+)[uUlL]*\\b", "name": "constant.numeric.dts" },
        { "match": "\\b[A-Z_][A-Z0-9_]*\\b", "name": "entity.name.function.preprocessor.dts" }
      ]
    }
  ],
  "repository": {
    "common": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.dts" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.dts" },
        {
          "begin": "\"", "end": "\"", "name": "string.quoted.double.dts",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.dts" }]
        },
        {
          "begin": "'", "end": "'", "name": "string.quoted.single.dts",
          "patterns": [{ "match": "\\\\.", "name": "constant.character.escape.dts" }]
        },
        {
          "match": "^\\s*(#\\s*include)\\s*(<[^>]+>|\"[^\"]+\")",
          "captures": {
            "1": { "name": "keyword.control.directive.dts" },
            "2": { "name": "string.quoted.include.dts" }
          }
        },
        {
          "begin": "^\\s*(#\\s*(?:define|undef|if|ifdef|ifndef|elif|else|endif|include|error|warning|pragma))(?=\\s|$|\\()",
          "beginCaptures": { "1": { "name": "keyword.control.directive.dts" } },
          "end": "(?<!\\\\)$",
          "patterns": [
            { "include": "#common" },
            { "match": "\\b[A-Za-z_][A-Za-z_0-9]*\\b", "name": "entity.name.function.preprocessor.dts" },
            { "match": "\\b(?:0[xX][[:xdigit:]]+|[0-9]+)\\b", "name": "constant.numeric.dts" }
          ]
        },
        { "match": "/(?:dts-v1|plugin|include|delete-node|delete-property|omit-if-no-ref|memreserve|bits|incbin)/", "name": "keyword.control.directive.dts" },
        { "match": "&(?:\\{/[^{}]*\\}|[A-Za-z_][A-Za-z_0-9]*)", "name": "variable.other.constant.reference.dts" },
        {
          "match": "([A-Za-z_][A-Za-z_0-9]*)(:)",
          "captures": {
            "1": { "name": "entity.name.function.label.dts" },
            "2": { "name": "punctuation.separator.label.dts" }
          }
        }
      ]
    }
  }
}
